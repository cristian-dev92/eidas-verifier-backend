# Variables de entorno para el backend (Render)
# Copiar/pegar estos valores en el panel de Render. NO subir un .env real a git.

SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://<host-neon>/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<usuario-neon>
SPRING_DATASOURCE_PASSWORD=<password-neon>
SPRING_JPA_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Dominio del frontend en Vercel (y local para pruebas)
APP_CORS_ALLOWED_ORIGINS=https://<tu-proyecto>.vercel.app,http://localhost:4200

# Identidad del verificador y alcance solicitado
APP_VERIFIER_CLIENT_ID=https://<tu-proyecto>.vercel.app
APP_VERIFIER_SCOPE=age_over_15
APP_VERIFIER_NONCE_TTL_SECONDS=180

# Emisor propio de credenciales (issuer)
APP_ISSUER_ID=https://issuer.eudi-demo.local
APP_ISSUER_CREDENTIAL_TTL_SECONDS=600
